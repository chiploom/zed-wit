package example:current@2.0.0+build.2;
interface operations {
    type completion = future;
    type pending-value = future<string>;
    type signal = stream;
    type chunks = stream<list<u8>>;
    read: async func(input: stream<u8>) -> future<result<string, string>>;
    resource task {
        start: static async func() -> task;
        wait: async func() -> result;
    }
}
world concurrent {
    import receive: async func() -> stream<u8>;
    export operations;
}
