    @since(version = 1.0.0)
    record metadata {
        value: string,
    }

    @since(version = 1.0.0)
    flags options {
        enabled,
    }

    @since(version = 1.0.0)
    enum states {
        ready,
    }

    @since(version = 1.0.0)
